    <ProjectReference Include="..\..\src\FFOccamMcp.Core\FFOccamMcp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fake-daemon.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
